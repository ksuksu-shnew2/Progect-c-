{
     "version": "0.2.0",
     "configurations": [
      {
        "command": "npm start",
        "name": "Run npm start",
        "request": "launch",
        "type": "node-terminal"
      },
      {
        "name": ".NET Core Attach",
        "type": "coreclr",
        "request": "attach"
      },
      
      {
        "name": "Run ProjectName",
        "type": "devtools",
        "request": "launch",
        "projectPath": "${workspaceFolder}/src/MyProject/MyProject.csproj",
        "withDebug": false
      },
      {
        "name": "Launch Project (Development)",
        "type": "devtools",
        "request": "launch",
        "projectPath": "${workspaceFolder}/src/MyProject/MyProject.csproj",
        "launchProfile": "Development",
        "withDebug": true
      },
      {
        "name": "Launch WebApp",
        "type": "devtools",
        "request": "launch",
        "projectPath": "${workspaceFolder}/src/WebApp/WebApp.csproj",
        "projectType": "web",
        "withDebug": true,
        "launchBrowser": true,
        "url": "https://localhost:5001"
      },
      {
        "name": "Launch ProjectName",
        "type": "devtools",
        "request": "launch",
        "projectPath": "${workspaceFolder}/src/MyProject/MyProject.csproj",
        "withDebug": true
      },
      {
        "name": "Launch and Debug Standalone Blazor WebAssembly App",
        "type": "blazorwasm",
        "request": "launch",
        "cwd": "${workspaceFolder}"
      },
      {
        "name": "Launch and Debug Hosted Blazor WebAssembly App",
        "type": "blazorwasm",
        "request": "launch",
        "hosted": true,
        "program": "${workspaceFolder}/bin/Debug/<target-framework>/<project-name.dll>",
        "cwd": "${workspaceFolder}"
      },
      {
        "name": ".NET Core Attach",
        "type": "coreclr",
        "request": "attach",
        "pipeTransport": {
          "pipeCwd": "${workspaceFolder}",
          "pipeProgram": "enter the fully qualified path for the pipe program name, for example '/usr/bin/ssh'",
          "pipeArgs": [],
          "debuggerPath": "enter the path for the debugger on the target machine, for example ~/vsdbg/vsdbg"
        }
      },
      {
        "name": ".NET Core Launch (web)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/bin/Debug/<target-framework>/<project-name.dll>",
        "args": [],
        "cwd": "${workspaceFolder}",
        "stopAtEntry": false,
        "serverReadyAction": {
          "action": "openExternally",
          "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
        },
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        },
        "sourceFileMap": {
          "/Views": "${workspaceFolder}/Views"
        }
      },
      {
        "name": ".NET Core Launch (console)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/bin/Debug/<target-framework>/<project-name.dll>",
        "args": [],
        "cwd": "${workspaceFolder}",
        "stopAtEntry": false,
        "console": "internalConsole"
      },
      {
        "name": "C#: <project-name> Debug",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder}/<relative-path-to-project-folder><project-name>.csproj"
      },
      {
        "name": "C#: <project-name> Debug",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder}/bin/Debug/net8.0/seeBattel2.dll"
      },
      {
        "name": ".NET Core Attach",
        "type": "coreclr",
        "request": "attach"
      },

       {
         "name": ".NET Run",
         "type": "coreclr",
         "request": "launch",
         "preLaunchTask": "build",
         "program": "${workspaceFolder}/bin/Debug/net8.0/seeBattel2.dll",
         "args": [],
         "cwd": "${workspaceFolder}",
         "stopAtEntry": false,
         "console": "integratedTerminal"
       }
     ]
   }